@model ViewsAndRazorDemo.Models.ProdutoViewModel
@{
    ViewBag.Title = "Cadastrar Produto - HTML Helpers";
}

<div style="margin-bottom: 1.5rem;">
    <h1>Cadastrar Novo Produto</h1>
    <p class="subtitle">Exemplo de formulário construído com os HTML Helpers clássicos do ASP.NET MVC 5.</p>
</div>

<div class="card" style="max-width: 650px;">
    <!-- Formulário construído com @using (Html.BeginForm()) e métodos de extensão -->
    @using (Html.BeginForm("Criar", "Produtos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

        <div class="form-group">
            @Html.LabelFor(m => m.Nome, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", placeholder = "Ex: Teclado Mecânico" })
            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Categoria, new { @class = "form-control", placeholder = "Ex: Periféricos" })
            @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Preco, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Preco, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.Preco, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
            @Html.CheckBoxFor(m => m.EmEstoque, new { id = "emEstoqueCheck", style = "width: 1.2rem; height: 1.2rem;" })
            <label for="emEstoqueCheck" style="margin: 0; cursor: pointer; font-weight: 500;">Disponível imediatamente em estoque</label>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
            <button type="submit" class="btn btn-primary" style="background-color: var(--legacy-red);">Salvar Produto</button>
            <a href="@Url.Action("Index", "Produtos")" class="btn btn-secondary">Cancelar</a>
        </div>
    }
</div>
