<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Lab 17: SignalR (.NET Framework 4.8.1)</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <!-- No ASP.NET SignalR 2.x clássico, jQuery e o script mágico /signalr/hubs eram obrigatórios -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr.js/2.4.3/jquery.signalR.min.js"></script>
    <script src="~/signalr/hubs"></script>
</head>
<body>
    <div class="container">
        <header style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <span class="badge badge-legacy">ASP.NET SignalR 2.x (.NET Framework 4.8.1) - Porta 6701</span>
                    <h1 style="font-size: 1.6rem; margin-top: 0.25rem;">Lab 17: SignalR Legado com OWIN e jQuery</h1>
                </div>
                <nav style="display: flex; gap: 1rem;">
                    @Html.ActionLink("Painel em Tempo Real", "Index", "Home", null, new { @class = "nav-link" })
                </nav>
            </div>
        </header>

        @RenderBody()

        <footer style="margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--text-muted); text-align: center;">
            .NET Modernization Lab - Conceito 17: Comunicação em Tempo Real com SignalR (.NET Framework 4.8.1 vs .NET 10)
        </footer>
    </div>
</body>
</html>
