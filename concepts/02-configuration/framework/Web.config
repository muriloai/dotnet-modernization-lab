<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!--
      No .NET Framework, qualquer seção customizada e estruturada exigia
      declarar o tipo da classe que implementa ConfigurationSection aqui no cabeçalho.
    -->
    <section name="configuracaoSmtp" type="ConfigurationDemo.Models.ConfiguracaoSmtpSection, ConfigurationDemo" />
  </configSections>

  <!--
    Configurações simples de chave e valor via appSettings.
    Limitações: todos os valores retornam como 'string' não tipada e não há recarregamento a quente.
  -->
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="Ambiente" value="Homologação (definido no Web.config)" />
    <add key="NomeSistema" value="Modernization Lab - Legado (Framework 4.8.1)" />
    <add key="LimiteItensPorPagina" value="25" />
    <add key="HabilitarAuditoria" value="true" />
  </appSettings>

  <!--
    Strings de conexão legadas acessadas por ConfigurationManager.ConnectionStrings["..."]
  -->
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=sql-legado.empresa.local;Database=DbLegado;User Id=sa;Password=SenhaLegada123!;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!--
    Instância da seção customizada declarada em configSections.
    Exigia mapeamento manual de atributos XML no C#.
  -->
  <configuracaoSmtp servidor="smtp.legado.empresa.com.br"
                    porta="587"
                    habilitarSsl="true"
                    emailRemetente="nao-responda@empresa.com.br" />

  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" />
  </system.web>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
