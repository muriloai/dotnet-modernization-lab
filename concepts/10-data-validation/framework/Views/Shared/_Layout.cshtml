<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Lab 10: Validação de Dados (.NET Framework 4.8.1)</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="container">
        <header style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <span class="badge badge-legacy">ASP.NET (.NET Framework 4.8.1) - Porta 6001</span>
                    <h1 style="font-size: 1.6rem; margin-top: 0.25rem;">Lab 10: Validação de Dados Legada</h1>
                </div>
                <nav style="display: flex; gap: 1rem;">
                    @Html.ActionLink("Painel da API", "Index", "ClientesMvc", null, new { @class = "nav-link" })
                    @Html.ActionLink("Formulário MVC", "Criar", "ClientesMvc", null, new { @class = "nav-link" })
                </nav>
            </div>
        </header>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div style="background-color: #d1e7dd; color: #0f5132; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; border: 1px solid #badbcc;">
                @TempData["MensagemSucesso"]
            </div>
        }

        @RenderBody()

        <footer style="margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--text-muted); text-align: center;">
            .NET Modernization Lab - Conceito 10: Validação de Dados e ProblemDetails
        </footer>
    </div>
</body>
</html>
