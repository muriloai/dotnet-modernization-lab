<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - .NET Modernization Lab</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <header style="margin-bottom: 2rem; border-bottom: 2px solid var(--border); padding-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <span class="badge">.NET 10 (LTS) - EF Core 10</span>
                    <h2 style="font-size: 1.4rem; color: var(--dark); margin-top: 0.25rem;">Lab 08: Entity Framework (EF 6 vs EF Core 10)</h2>
                </div>
                <nav style="display: flex; gap: 0.75rem;">
                    <a asp-controller="Produtos" asp-action="Index" class="btn btn-secondary">Catálogo de Produtos</a>
                    <a asp-controller="Produtos" asp-action="Criar" class="btn btn-primary">+ Novo Produto</a>
                </nav>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>
    </div>
</body>
</html>
